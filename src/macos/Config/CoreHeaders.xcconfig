// Header search paths for the RHVoice engine (C++ core). Included by Core.xcconfig and CLI.xcconfig.
RHVOICE_BOOST = $(RHVOICE_ROOT)/external/libs/boost/libs
RHVOICE_BOOST_INCLUDES = $(RHVOICE_BOOST)/algorithm/include $(RHVOICE_BOOST)/align/include $(RHVOICE_BOOST)/array/include $(RHVOICE_BOOST)/assert/include $(RHVOICE_BOOST)/bind/include $(RHVOICE_BOOST)/concept_check/include $(RHVOICE_BOOST)/config/include $(RHVOICE_BOOST)/container/include $(RHVOICE_BOOST)/container_hash/include $(RHVOICE_BOOST)/core/include $(RHVOICE_BOOST)/date_time/include $(RHVOICE_BOOST)/detail/include $(RHVOICE_BOOST)/exception/include $(RHVOICE_BOOST)/function/include $(RHVOICE_BOOST)/integer/include $(RHVOICE_BOOST)/interprocess/include $(RHVOICE_BOOST)/intrusive/include $(RHVOICE_BOOST)/io/include $(RHVOICE_BOOST)/iterator/include $(RHVOICE_BOOST)/json/include $(RHVOICE_BOOST)/lexical_cast/include $(RHVOICE_BOOST)/move/include $(RHVOICE_BOOST)/mp11/include $(RHVOICE_BOOST)/mpl/include $(RHVOICE_BOOST)/nowide/include $(RHVOICE_BOOST)/numeric_conversion/include $(RHVOICE_BOOST)/optional/include $(RHVOICE_BOOST)/predef/include $(RHVOICE_BOOST)/preprocessor/include $(RHVOICE_BOOST)/range/include $(RHVOICE_BOOST)/smart_ptr/include $(RHVOICE_BOOST)/static_assert/include $(RHVOICE_BOOST)/system/include $(RHVOICE_BOOST)/throw_exception/include $(RHVOICE_BOOST)/tokenizer/include $(RHVOICE_BOOST)/tuple/include $(RHVOICE_BOOST)/type_index/include $(RHVOICE_BOOST)/type_traits/include $(RHVOICE_BOOST)/unordered/include $(RHVOICE_BOOST)/utility/include $(RHVOICE_BOOST)/variant2/include $(RHVOICE_BOOST)/winapi/include
RHVOICE_CORE_INCLUDES = $(RHVOICE_SRC)/include $(RHVOICE_SRC)/hts_engine $(RHVOICE_SRC)/third-party/utf8 $(RHVOICE_SRC)/third-party/rapidxml $(SRCROOT)/RHVoiceCore/include
HEADER_SEARCH_PATHS = $(inherited) $(RHVOICE_CORE_INCLUDES) $(RHVOICE_BOOST_INCLUDES)
