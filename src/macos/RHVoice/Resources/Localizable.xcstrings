{
  "sourceLanguage": "en",
  "strings": {
    "Are you sure you want to uninstall this voice?": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы сапраўды жадаеце выдаліць гэты голас?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esteu segur que voleu desintal·lar aquesta veu?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete odinstalovat tento hlas?"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ĉu vi certe volas malinstali tiun ĉi voĉon?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres desinstalar esta voz?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko varma, että haluat poistaa tämän äänen?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste li sigurni da želite ukloniti ovaj glas?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan eltávolítod a kijelölt hangot?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул үндү өчүрүү керекпи?"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дали сте сигурни дека сакате да го избришете овој глас??"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy jesteś pewien, że chcesz usunąć ten głos?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza que quer desinstalar esta voz?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur doriți să dezinstalați această voce?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот голос?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste si istí, že si želáte odinštalovať tento hlas?"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Je i sigurt që dëshiron ta çinstalosh këtë zë?"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Јесте ли сигурни да желите да деинсталирате овај глас?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити цей голос?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovozni o'chirib tashlashni xohlaysizmi?"
          }
        }
      }
    },
